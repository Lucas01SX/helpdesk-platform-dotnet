{
  "ConnectionStrings": {
    "Default": "override-via-environment-variable"
  },
  "Jwt": {
    "SecretKey": "override-via-environment-variable",
    "Issuer": "helpdesk-api",
    "Audience": "helpdesk-clients",
    "ExpiryMinutes": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
